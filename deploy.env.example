# Skopiuj jako deploy.env (plik jest w .gitignore). Dane z DirectAdmin → Konto → Dostęp SSH.
KW_SSH_HOST=serwer.seohost.pl
KW_SSH_USER=uzytkownik
KW_SSH_PORT=22
KW_DOMAIN=infoportal.abuczek.pl
# adres publiczny: osobna domena w DirectAdmin, deploy.sh kieruje jej public_html na katalog KW_DOMAIN
KW_PUBLIC_DOMAIN=zanimwyjdziesz.pl
# opcjonalnie, gdy domyślne `php` w konsoli jest starsze niż 8.1:
# KW_PHP=/usr/local/php84/bin/php
# e-mail na alerty o stanie danych (server/bin/check-health.php); zapisywany na serwerze w config/local.php
# KW_ALERT_EMAIL=ty@example.com
