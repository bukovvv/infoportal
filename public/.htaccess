DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # katalog server/ wewnątrz docroot (hosting bez zmiany katalogu dokumentów) nigdy nie jest publiczny
    RewriteRule ^server(/|$) - [F,L]

    # odnawianie certyfikatów SSL bez przekierowań
    RewriteRule ^\.well-known/ - [L]

    # www.zanimwyjdziesz.pl → zanimwyjdziesz.pl
    RewriteCond %{HTTP_HOST} ^www\.zanimwyjdziesz\.pl$ [NC]
    RewriteRule ^ https://zanimwyjdziesz.pl%{REQUEST_URI} [R=301,L]

    # stary adres infoportal.abuczek.pl → zanimwyjdziesz.pl: API i pliki przekierowaniem 301, strony przez
    # przenosiny.html (przenosi ulubione stacje i ustawienia z localStorage, przypisane do adresu).
    # sw.js zostaje, by działały powiadomienia włączone jeszcze na starym adresie.
    RewriteCond %{HTTP_HOST} ^infoportal\.abuczek\.pl$ [NC]
    RewriteRule ^(sw\.js|przenosiny\.(html|js)|app-icon-192\.png)$ - [L]
    RewriteCond %{HTTP_HOST} ^infoportal\.abuczek\.pl$ [NC]
    RewriteCond %{REQUEST_URI} ^/api(/|$) [OR]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ https://zanimwyjdziesz.pl%{REQUEST_URI} [R=301,L]
    RewriteCond %{HTTP_HOST} ^infoportal\.abuczek\.pl$ [NC]
    RewriteRule ^ przenosiny.html [L]

    # JSON API; mapa strony dla wyszukiwarek generowana z rozkładu (lista stacji) i komunikatów
    RewriteRule ^api(/.*)?$ api/index.php [QSA,L]
    RewriteRule ^sitemap\.xml$ api/index.php [L]

    # pliki statyczne bez zmian, reszta → aplikacja (vue-router w trybie historii)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=(), usb=(), browsing-topics=()"
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://tiles.openfreemap.org; connect-src 'self' https://tiles.openfreemap.org; worker-src 'self' blob:; manifest-src 'self'"
    # HTTPS przez rok (http:// przekierowuje już hosting); bez includeSubDomains i preload — do decyzji po starcie
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set Cross-Origin-Opener-Policy "same-origin"

    # zasoby z hashem w nazwie — cache na rok; index.html zawsze świeży
    <FilesMatch "\.(js|css|woff2?|svg|png)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "^(index\.html|manifest\.webmanifest|favicon\.svg|sw\.js|og-image\.png|app-icon-(192|512)\.png|przenosiny\.(html|js))$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/manifest+json
</IfModule>
